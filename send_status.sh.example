#!/bin/bash
# Renders vpsmon dashboard and sends it via Telegram Bot API.
# Copy this file to send_status.sh and fill in your credentials.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VPSMON="$SCRIPT_DIR/zig-out/bin/vpsmon"
OUTPUT="/tmp/vpsmon_$(date +%s).png"

# ── Configure these ──────────────────────────────────────
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
# ─────────────────────────────────────────────────────────

# 1. Render to PNG (hacker green on black)
"$VPSMON" "$OUTPUT" > /dev/null

# 2. Send via Telegram Bot API
curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto" \
  -F "chat_id=${CHAT_ID}" \
  -F "photo=@${OUTPUT}" \
  -o /dev/null

# 3. Cleanup
rm -f "$OUTPUT"

echo "OK"
